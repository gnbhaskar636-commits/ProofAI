# Optional. Stamped onto every CooL receipt. Defaults to "proofai".
COOL_APPLICATION_ID=proofai

# Optional. If unset, CooL uses its built-in simulator.
# Receipts are labelled "simulated". Binding and signature checks are still real.
# COOL_DSTACK_ENDPOINT=http://127.0.0.1:8090

# Optional HTTP port for the ProofAI server. Default 8787.
# PORT=8787

# Optional path for the local JSON evidence store.
# PROOFAI_STORE=./data/store.json

# Optional. Enables AI Change Intelligence, the Evidence Copilot, and the
# Executive Evidence Brief. Server-side only. Never expose this key to the
# browser. Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional. Any model slug OpenRouter hosts (e.g. openai/gpt-4o-mini,
# anthropic/claude-3.5-haiku, google/gemini-2.0-flash-001). Defaults to
# openai/gpt-4o-mini if unset.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Sent as the HTTP-Referer header on OpenRouter requests — used
# only for OpenRouter's own usage attribution, not required to function.
# OPENROUTER_SITE_URL=https://proofai.app
